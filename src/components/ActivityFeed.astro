---
import { db, comments, reactions } from 'astro:db'
import { getSanityPosts } from '../utils/getSanityPosts'

type CommentActivity = {
  type: 'comment'
  name: string
  postId: string
  date: Date
  preview: string
}

type ReactionActivity = {
  type: 'reaction'
  postId: string
  date: Date
  emoji: string
}

type Activity = CommentActivity | ReactionActivity

const posts = await getSanityPosts()
const postMap = Object.fromEntries(
  posts.filter((post: any) => post?._id && post?.slug?.current).map((post: any) => [post._id, post])
)

const getFirstName = (name: string) => name.trim().split(/\s+/)[0] || name
const recentComments = (await db.select().from(comments))
  .filter((comment) => comment.approved)
  .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  .slice(0, 5)
const recentReactions = (await db.select().from(reactions))
  .sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime())
  .slice(0, 5)

const activities: Activity[] = [
  ...recentComments.map((comment) => ({
    type: 'comment' as const,
    name: getFirstName(comment.name),
    postId: comment.postId,
    date: comment.createdAt,
    preview: comment.content.substring(0, 50) + (comment.content.length > 50 ? '...' : ''),
  })),
  ...recentReactions.map((reaction) => ({
    type: 'reaction' as const,
    postId: reaction.postId,
    date: reaction.createdAt,
    emoji: reaction.emoji,
  })),
]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 8)
---

{activities.length > 0 && (
  <section class="activity-feed" aria-labelledby="activity-title">
    <h2 id="activity-title">recent activity</h2>
    <ul>
      {activities.map((activity) => {
        const post = postMap[activity.postId]
        const postUrl = post?.slug?.current ? `/notes/${post.slug.current}` : undefined
        return (
          <li>
            <span class="activity-mark" aria-hidden="true">
              {activity.type === 'comment' ? '·' : activity.emoji}
            </span>
            <span class="activity-copy">
              {activity.type === 'comment' ? (
                <>{activity.name} commented: “{activity.preview}”</>
              ) : (
                <>Someone reacted</>
              )}
              {postUrl && (
                <> on <a href={postUrl}>{post.title}</a></>
              )}
            </span>
            <time>
              {new Date(activity.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
            </time>
          </li>
        )
      })}
    </ul>
  </section>
)}

<style>
  .activity-feed {
    margin-bottom: 4rem;
  }

  h2 {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 1rem;
    text-transform: lowercase;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    align-items: baseline;
    display: grid;
    gap: 0.65rem;
    grid-template-columns: 1rem minmax(0, 1fr) auto;
    padding: 0.28rem 0;
  }

  .activity-mark {
    color: var(--text-muted);
    font-size: 0.66rem;
    line-height: 1.55;
  }

  .activity-copy {
    color: var(--text-muted);
    font-size: 0.68rem;
    line-height: 1.65;
  }

  .activity-copy a {
    color: var(--text-color);
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .activity-copy a:hover,
  .activity-copy a:focus-visible {
    color: var(--accent);
  }

  time {
    color: var(--text-muted);
    font-size: 0.62rem;
    line-height: 1.55;
  }

  @media (max-width: 32rem) {
    li {
      grid-template-columns: 1rem minmax(0, 1fr);
    }

    time {
      grid-column: 2;
    }
  }
</style>
