<div id="page-loader" data-state="hidden" transition:persist="page-loader" aria-hidden="true">
  <div class="loader-panel loader-panel-top"></div>
  <div class="loader-panel loader-panel-bottom"></div>
  <span data-count>0</span>
</div>

<style>
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    visibility: visible;
  }

  #page-loader[data-state='hidden'] {
    visibility: hidden;
    pointer-events: none;
  }

  .loader-panel {
    position: absolute;
    right: 0;
    left: 0;
    height: 50.1%;
    background: var(--bg-primary);
    transition: transform 420ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .loader-panel-top {
    top: 0;
  }

  .loader-panel-bottom {
    bottom: 0;
  }

  #page-loader[data-state='dismissing'] .loader-panel-top,
  #page-loader[data-state='hidden'] .loader-panel-top {
    transform: translateY(-100%);
  }

  #page-loader[data-state='dismissing'] .loader-panel-bottom,
  #page-loader[data-state='hidden'] .loader-panel-bottom {
    transform: translateY(100%);
  }

  #page-loader [data-count] {
    position: relative;
    z-index: 1;
    color: #fff;
    font-size: clamp(3rem, 10vw, 6rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition: opacity 140ms ease;
  }

  #page-loader[data-state='dismissing'] [data-count],
  #page-loader[data-state='hidden'] [data-count] {
    opacity: 0;
  }

  #page-loader.is-resetting .loader-panel,
  #page-loader.is-resetting [data-count] {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .loader-panel,
    #page-loader [data-count] {
      transition: none;
    }
  }
</style>

<script>
  const loader = document.querySelector<HTMLElement>('#page-loader')
  const counter = loader?.querySelector<HTMLElement>('[data-count]')

  if (loader && counter) {
    let revealTimer = 0
    let hideTimer = 0
    let navigation = 0
    let progress = 0
    let pending = false
    let target = ''
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const nativeFetch = window.fetch.bind(window)

    const showCount = (value: number) => {
      progress = Math.max(progress, Math.min(99, value))
      if (value === 100) progress = 100
      counter.textContent = String(progress)
    }

    const hide = () => {
      loader.dataset.state = 'dismissing'
      hideTimer = window.setTimeout(() => {
        loader.dataset.state = 'hidden'
      }, reduceMotion.matches ? 0 : 440)
    }

    const show = () => {
      clearTimeout(hideTimer)
      loader.classList.add('is-resetting')
      loader.dataset.state = 'loading'
      void loader.offsetHeight
      loader.classList.remove('is-resetting')
    }

    const schedule = (url = '') => {
      const currentNavigation = ++navigation
      pending = true
      target = url
      progress = 0
      counter.textContent = '0'
      clearTimeout(revealTimer)
      clearTimeout(hideTimer)
      loader.dataset.state = 'hidden'
      revealTimer = window.setTimeout(() => {
        if (pending && currentNavigation === navigation) show()
      }, 150)
    }

    const finish = () => {
      if (!pending) return
      pending = false
      target = ''
      clearTimeout(revealTimer)
      if (loader.dataset.state !== 'loading') return
      showCount(100)
      hideTimer = window.setTimeout(hide, reduceMotion.matches ? 0 : 120)
    }

    window.fetch = async (input, init) => {
      const response = await nativeFetch(input, init)
      const url = new URL(input instanceof Request ? input.url : String(input), location.href).href
      const requestNavigation = navigation
      const total = Number(response.headers.get('content-length'))

      if (pending && url === target && total > 0 && response.body) {
        const reader = response.clone().body!.getReader()
        void (async () => {
          let received = 0
          try {
            while (true) {
              const {done, value} = await reader.read()
              if (done) break
              received += value.byteLength
              if (requestNavigation === navigation && pending) {
                showCount(Math.min(99, Math.floor(received / total * 100)))
              }
            }
          } catch {
            await reader.cancel().catch(() => {})
          }
        })()
      }

      return response
    }

    document.addEventListener('astro:before-preparation', (event) => {
      schedule(event.to.href)
      event.signal.addEventListener('abort', () => {
        if (target !== event.to.href) return
        pending = false
        clearTimeout(revealTimer)
        hide()
      }, {once: true})
    })
    document.addEventListener('astro:page-load', finish)

    if (document.readyState !== 'complete') {
      schedule()
      window.addEventListener('load', finish, { once: true })
    }
  }
</script>
