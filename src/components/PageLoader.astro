<div
  id="page-loader"
  data-state="hidden"
  transition:persist="page-loader"
  aria-hidden="true"
  class="pointer-events-none fixed right-3 top-3 z-50 flex -translate-y-1.5 items-center gap-2 rounded-full border border-[var(--border-color)] bg-[var(--bg-secondary)] px-2.5 py-2 opacity-0 shadow-lg transition-[opacity,transform] duration-200 ease-out sm:right-5 sm:top-5"
>
  <img
    src="/favicon.png"
    alt=""
    width="24"
    height="24"
    class="h-6 w-6 rounded-full object-cover [image-rendering:pixelated]"
  />
  <span class="text-[0.65rem] font-medium leading-none text-[var(--text-muted)]">Loading</span>
  <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[var(--accent)] motion-reduce:animate-none"></span>
</div>

<script>
  type LoaderWindow = Window & {__pageLoaderCleanup?: () => void}

  const loaderWindow = window as LoaderWindow
  loaderWindow.__pageLoaderCleanup?.()

  let revealTimer = 0
  let safetyTimer = 0
  let navigation = 0
  const getLoader = () => document.querySelector<HTMLElement>('#page-loader')

  const setVisible = (visible: boolean) => {
    const loader = getLoader()
    if (!loader) return
    loader.dataset.state = visible ? 'loading' : 'hidden'
    loader.classList.toggle('opacity-0', !visible)
    loader.classList.toggle('-translate-y-1.5', !visible)
    loader.classList.toggle('opacity-100', visible)
    loader.classList.toggle('translate-y-0', visible)
  }

  const hide = (currentNavigation = navigation) => {
    if (currentNavigation !== navigation) return
    window.clearTimeout(revealTimer)
    window.clearTimeout(safetyTimer)
    setVisible(false)
  }

  const onBeforePreparation = (event: DocumentEventMap['astro:before-preparation']) => {
    const currentNavigation = ++navigation
    window.clearTimeout(revealTimer)
    window.clearTimeout(safetyTimer)
    setVisible(false)

    revealTimer = window.setTimeout(() => {
      if (currentNavigation !== navigation) return
      setVisible(true)
    }, 250)

    safetyTimer = window.setTimeout(() => hide(currentNavigation), 10000)
    event.signal.addEventListener('abort', () => hide(currentNavigation), {once: true})

    queueMicrotask(() => {
      if (event.defaultPrevented) hide(currentNavigation)
    })
  }

  const onLoaded = () => hide()

  document.addEventListener('astro:before-preparation', onBeforePreparation)
  document.addEventListener('astro:after-swap', onLoaded)
  document.addEventListener('astro:page-load', onLoaded)

  loaderWindow.__pageLoaderCleanup = () => {
    document.removeEventListener('astro:before-preparation', onBeforePreparation)
    document.removeEventListener('astro:after-swap', onLoaded)
    document.removeEventListener('astro:page-load', onLoaded)
    window.clearTimeout(revealTimer)
    window.clearTimeout(safetyTimer)
    setVisible(false)
  }
</script>
