<div id="page-loader" data-state="hidden" transition:persist="page-loader" aria-hidden="true">
  <div class="loader-panel loader-panel-top"></div>
  <div class="loader-panel loader-panel-bottom"></div>
  <span data-count>0</span>
</div>

<style>
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    visibility: visible;
  }

  #page-loader[data-state='hidden'] {
    visibility: hidden;
    pointer-events: none;
  }

  .loader-panel {
    position: absolute;
    right: 0;
    left: 0;
    height: 50.1%;
    background: var(--bg-primary);
    transition: transform 420ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .loader-panel-top {
    top: 0;
  }

  .loader-panel-bottom {
    bottom: 0;
  }

  #page-loader[data-state='dismissing'] .loader-panel-top,
  #page-loader[data-state='hidden'] .loader-panel-top {
    transform: translateY(-100%);
  }

  #page-loader[data-state='dismissing'] .loader-panel-bottom,
  #page-loader[data-state='hidden'] .loader-panel-bottom {
    transform: translateY(100%);
  }

  #page-loader [data-count] {
    position: relative;
    z-index: 1;
    color: #fff;
    font-size: clamp(3rem, 10vw, 6rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transition: opacity 140ms ease;
  }

  #page-loader[data-state='dismissing'] [data-count],
  #page-loader[data-state='hidden'] [data-count] {
    opacity: 0;
  }

  #page-loader.is-resetting .loader-panel,
  #page-loader.is-resetting [data-count] {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .loader-panel,
    #page-loader [data-count] {
      transition: none;
    }
  }
</style>

<script>
  const loader = document.querySelector<HTMLElement>('#page-loader')
  const counter = loader?.querySelector<HTMLElement>('[data-count]')

  if (loader && counter) {
    let frame = 0
    let revealTimer = 0
    let hideTimer = 0
    let navigation = 0
    let progress = 0
    let startedAt = 0
    let finishingAt = 0
    let finishingFrom = 0
    let phase: 'loading' | 'finishing' | 'dismissing' | 'hidden' = 'hidden'
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    const showCount = (value: number) => {
      progress = value
      counter.textContent = String(value)
    }

    const tick = (now: number) => {
      if (phase === 'loading') {
        const elapsed = Math.max(0, now - startedAt)
        showCount(Math.min(95, Math.floor(95 * (1 - Math.exp(-elapsed / 700)))))
        frame = requestAnimationFrame(tick)
        return
      }

      if (phase === 'finishing') {
        const duration = reduceMotion.matches ? 0 : 160
        const fraction = duration === 0 ? 1 : Math.min(1, (now - finishingAt) / duration)
        showCount(Math.min(100, Math.floor(finishingFrom + (100 - finishingFrom) * fraction)))

        if (fraction < 1) {
          frame = requestAnimationFrame(tick)
        } else {
          phase = 'dismissing'
          loader.dataset.state = 'dismissing'
          hideTimer = window.setTimeout(() => {
            phase = 'hidden'
            loader.dataset.state = 'hidden'
          }, reduceMotion.matches ? 0 : 440)
        }
      }
    }

    const show = () => {
      cancelAnimationFrame(frame)
      clearTimeout(hideTimer)
      phase = 'loading'
      startedAt = performance.now()
      showCount(0)
      loader.classList.add('is-resetting')
      loader.dataset.state = 'loading'
      void loader.offsetHeight
      loader.classList.remove('is-resetting')
      frame = requestAnimationFrame(tick)
    }

    const schedule = () => {
      const currentNavigation = ++navigation
      clearTimeout(revealTimer)

      if (phase === 'finishing' || phase === 'dismissing') {
        cancelAnimationFrame(frame)
        clearTimeout(hideTimer)
        phase = 'hidden'
        loader.dataset.state = 'hidden'
      }

      if (phase === 'loading') return

      revealTimer = window.setTimeout(() => {
        if (currentNavigation === navigation) show()
      }, 160)
    }

    const finish = () => {
      navigation += 1
      clearTimeout(revealTimer)
      if (phase !== 'loading') return
      cancelAnimationFrame(frame)
      phase = 'finishing'
      finishingFrom = progress
      finishingAt = performance.now()
      frame = requestAnimationFrame(tick)
    }

    document.addEventListener('astro:before-preparation', schedule)
    document.addEventListener('astro:page-load', finish)

    if (document.readyState !== 'complete') {
      schedule()
      window.addEventListener('load', finish, { once: true })
    }
  }
</script>
