<div id="page-loader" data-state="hidden" transition:persist="page-loader" aria-hidden="true">
  <div class="loader-panel loader-panel-top"></div>
  <div class="loader-panel loader-panel-bottom"></div>
  <img src="/favicon.png" alt="" width="96" height="96" />
</div>

<style>
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    visibility: visible;
  }

  #page-loader[data-state='hidden'] {
    visibility: hidden;
    pointer-events: none;
  }

  .loader-panel {
    position: absolute;
    right: 0;
    left: 0;
    height: 50.1%;
    background: var(--bg-primary);
    transition: transform 420ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .loader-panel-top {
    top: 0;
  }

  .loader-panel-bottom {
    bottom: 0;
  }

  #page-loader[data-state='dismissing'] .loader-panel-top,
  #page-loader[data-state='hidden'] .loader-panel-top {
    transform: translateY(-100%);
  }

  #page-loader[data-state='dismissing'] .loader-panel-bottom,
  #page-loader[data-state='hidden'] .loader-panel-bottom {
    transform: translateY(100%);
  }

  #page-loader img {
    position: relative;
    z-index: 1;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    height: 6rem;
    image-rendering: pixelated;
    object-fit: cover;
    transition: opacity 140ms ease;
    width: 6rem;
  }

  #page-loader[data-state='dismissing'] img,
  #page-loader[data-state='hidden'] img {
    opacity: 0;
  }

  #page-loader.is-resetting .loader-panel,
  #page-loader.is-resetting img {
    transition: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .loader-panel,
    #page-loader img {
      transition: none;
    }
  }
</style>

<script>
  const loader = document.querySelector<HTMLElement>('#page-loader')

  if (loader) {
    let revealTimer = 0
    let hideTimer = 0
    let navigation = 0
    let pending = false
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    const hide = () => {
      loader.dataset.state = 'dismissing'
      hideTimer = window.setTimeout(() => {
        loader.dataset.state = 'hidden'
      }, reduceMotion.matches ? 0 : 440)
    }

    const show = () => {
      clearTimeout(hideTimer)
      loader.classList.add('is-resetting')
      loader.dataset.state = 'loading'
      void loader.offsetHeight
      loader.classList.remove('is-resetting')
    }

    const schedule = () => {
      const currentNavigation = ++navigation
      pending = true
      clearTimeout(revealTimer)
      clearTimeout(hideTimer)
      loader.dataset.state = 'hidden'
      revealTimer = window.setTimeout(() => {
        if (pending && currentNavigation === navigation) show()
      }, 150)
    }

    const finish = () => {
      if (!pending) return
      pending = false
      clearTimeout(revealTimer)
      if (loader.dataset.state !== 'loading') return
      hide()
    }

    document.addEventListener('astro:before-preparation', (event) => {
      schedule()
      const currentNavigation = navigation
      event.signal.addEventListener('abort', () => {
        if (currentNavigation !== navigation) return
        pending = false
        clearTimeout(revealTimer)
        if (loader.dataset.state === 'loading') hide()
      }, {once: true})
    })
    document.addEventListener('astro:page-load', finish)

    if (document.readyState !== 'complete') {
      schedule()
      window.addEventListener('load', finish, { once: true })
    }
  }
</script>
