---
import { getSanityPosts } from '../utils/getSanityPosts'

const allPosts = await getSanityPosts()
const recentPosts = allPosts
  .filter((post: any) => post?.slug?.current)
  .slice(0, 5)
  .map((post: any) => ({ ...post, postUrl: `/notes/${post.slug.current}` }))

const formatPostDate = (post: any) => {
  const date = post.firstPublishedAt || post.publishedAt || post._createdAt
  const parsedDate = date ? new Date(date) : null

  return parsedDate && !Number.isNaN(parsedDate.getTime())
    ? parsedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
    : 'Unknown'
}
---

{recentPosts.length > 0 && (
  <section class="recent-posts" aria-labelledby="recent-posts-title">
    <h2 id="recent-posts-title">recent notes</h2>
    <ul>
      {recentPosts.map((post: any) => (
        <li>
          <a href={post.postUrl}>
            <span>{post.title}</span>
            <time>{formatPostDate(post)}</time>
          </a>
        </li>
      ))}
    </ul>
    <a class="all-notes" href="/notes">All notes <span aria-hidden="true">→</span></a>
  </section>
)}

<style>
  .recent-posts {
    margin-bottom: 4.5rem;
  }

  h2 {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 1rem;
    text-transform: lowercase;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li a {
    align-items: baseline;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.3rem 0;
  }

  li a > span {
    font-size: 0.74rem;
    line-height: 1.55;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2rem;
  }

  li a:hover > span,
  li a:focus-visible > span {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  time {
    color: var(--text-muted);
    flex: 0 0 auto;
    font-size: 0.65rem;
    line-height: 1.55;
  }

  .all-notes {
    color: var(--text-muted);
    display: inline-block;
    font-size: 0.68rem;
    margin-top: 1rem;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .all-notes:hover,
  .all-notes:focus-visible {
    color: var(--text-color);
  }
</style>
