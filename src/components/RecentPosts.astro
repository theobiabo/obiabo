---
import { getSanityPosts } from '../utils/getSanityPosts'

const allPosts = await getSanityPosts()
const recentPosts = allPosts
  .filter((post: any) => post?.slug?.current)
  .slice(0, 6)
  .map((post: any) => ({ ...post, postUrl: `/notes/${post.slug.current}` }))

const formatPostDate = (post: any) => {
  const date = post.firstPublishedAt || post.publishedAt || post._createdAt
  const parsedDate = date ? new Date(date) : null

  return parsedDate && !Number.isNaN(parsedDate.getTime())
    ? parsedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
    : 'Unknown'
}
---

<section class="recent-posts" id="writing" aria-labelledby="recent-posts-title">
  <div class="writing-heading">
    <h2 id="recent-posts-title">Latest stories</h2>
    {recentPosts.length > 1 && (
      <div class="writing-controls" aria-label="Writing carousel controls">
        <button type="button" data-writing-prev aria-label="Previous stories">←</button>
        <button type="button" data-writing-next aria-label="Next stories">→</button>
      </div>
    )}
  </div>
  <p class="writing-intro">A few recent pieces on whatever catches my interest.</p>
  {recentPosts.length > 0 && (
    <ul data-writing-track>
      {recentPosts.map((post: any) => (
        <li>
          <a href={post.postUrl}>
            <time>{formatPostDate(post)}</time>
            {post.mainImage?.asset?.url && <img src={post.mainImage.asset.url} alt={post.mainImage.alt || post.title} loading="lazy" decoding="async" />}
            <span class="post-title">{post.title}</span>
            {post.description && <span class="post-description">{post.description}</span>}
          </a>
        </li>
      ))}
    </ul>
  )}
  <a class="all-notes" href="/notes">Browse all writing <span aria-hidden="true">→</span></a>
</section>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest?.('[data-writing-prev], [data-writing-next]')
    if (!button) return
    const track = button.closest('.recent-posts')?.querySelector<HTMLElement>('[data-writing-track]')
    if (!track) return
    const gap = Number.parseFloat(getComputedStyle(track).columnGap) || 0
    const distance = track.clientWidth + gap
    const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
    track.scrollBy({left: button.hasAttribute('data-writing-next') ? distance : -distance, behavior})
  })
</script>

<style>
  .recent-posts {
    margin-bottom: 4rem;
    scroll-margin-top: 2rem;
  }

  h2 {
    color: var(--text-color);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.5;
    margin: 0;
  }

  .writing-heading {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }

  .writing-controls {
    display: flex;
    gap: 0.4rem;
  }

  .writing-controls button {
    border: 1px solid var(--border-color);
    border-radius: 50%;
    color: var(--text-color);
    cursor: pointer;
    font-size: 0.9rem;
    height: 2rem;
    line-height: 1;
    width: 2rem;
  }

  .writing-controls button:hover,
  .writing-controls button:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .writing-intro {
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.6;
    margin: 0 0 1.25rem;
  }

  ul {
    display: grid;
    gap: 1rem;
    grid-auto-columns: 100%;
    grid-auto-flow: column;
    list-style: none;
    margin: 0;
    overflow-x: auto;
    padding: 0;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  ul::-webkit-scrollbar {
    display: none;
  }

  li {
    min-width: 0;
    scroll-snap-align: start;
  }

  li a {
    display: grid;
    gap: 0.45rem;
    height: 100%;
    align-content: start;
  }

  img {
    aspect-ratio: 1.55;
    background: var(--bg-secondary);
    object-fit: cover;
    width: 100%;
  }

  .post-title {
    font-size: 0.82rem;
    line-height: 1.55;
    font-weight: 700;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .post-description {
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  li a:hover .post-title,
  li a:focus-visible .post-title {
    color: var(--accent);
  }

  time {
    color: var(--text-muted);
    font-size: 0.65rem;
    line-height: 1.55;
  }

  .all-notes {
    color: var(--text-color);
    display: inline-block;
    font-size: 0.76rem;
    margin-top: 1.25rem;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .all-notes:hover,
  .all-notes:focus-visible {
    color: var(--accent);
  }

  @media (min-width: 768px) {
    ul { grid-auto-columns: calc((100% - 1rem) / 2); }
  }

  @media (prefers-reduced-motion: reduce) {
    ul { scroll-behavior: auto; }
  }
</style>
