---
import Nav from './nav.astro'
import StoryViewer from '../StoryViewer.astro'
import { getSanityContact } from '../../utils/getSanityContact'
import { getSanityGallery } from '../../utils/getSanityGallery'
import { defaultTheme, getSanityTheme } from '../../utils/getSanityTheme'

const [contact, sanityTheme, galleryItems] = await Promise.all([
  getSanityContact(),
  getSanityTheme(),
  getSanityGallery(),
])
const stories = galleryItems.slice(0, 3)
const personalUrls = (contact?.links?.filter((item) => item.showInHeader) ?? []).map((item) => {
  const value = `${item.title} ${item.headerTitle ?? ''} ${item.url}`.toLowerCase()
  const kind = value.includes('github')
    ? 'github'
    : value.includes('linkedin')
      ? 'linkedin'
      : value.includes('twitter') || value.includes('x.com')
        ? 'x'
        : value.includes('mail')
          ? 'email'
          : 'link'

  return { ...item, kind }
})

const isSafeFontUrl = (value?: string) => Boolean(value && /^https:\/\/fonts\.googleapis\.com\/css2\?/.test(value))
const isSafeFontFamily = (value?: string) => Boolean(value && /^[\w\s"',-]+$/.test(value))
const isSafeColor = (value?: string) => Boolean(value && /^#[0-9a-f]{6}$/i.test(value))

const theme = {
  fontStylesheetUrl: isSafeFontUrl(sanityTheme?.fontStylesheetUrl) ? sanityTheme?.fontStylesheetUrl : defaultTheme.fontStylesheetUrl,
  monoFontFamily: isSafeFontFamily(sanityTheme?.monoFontFamily) ? sanityTheme?.monoFontFamily : defaultTheme.monoFontFamily,
  serifFontFamily: isSafeFontFamily(sanityTheme?.serifFontFamily) ? sanityTheme?.serifFontFamily : defaultTheme.serifFontFamily,
  primaryBackgroundColor: isSafeColor(sanityTheme?.primaryBackgroundColor) ? sanityTheme?.primaryBackgroundColor : defaultTheme.primaryBackgroundColor,
  secondaryBackgroundColor: isSafeColor(sanityTheme?.secondaryBackgroundColor) ? sanityTheme?.secondaryBackgroundColor : defaultTheme.secondaryBackgroundColor,
  primaryTextColor: isSafeColor(sanityTheme?.primaryTextColor) ? sanityTheme?.primaryTextColor : defaultTheme.primaryTextColor,
  mutedTextColor: isSafeColor(sanityTheme?.mutedTextColor) ? sanityTheme?.mutedTextColor : defaultTheme.mutedTextColor,
  borderColor: isSafeColor(sanityTheme?.borderColor) ? sanityTheme?.borderColor : defaultTheme.borderColor,
  accentColor: isSafeColor(sanityTheme?.accentColor) ? sanityTheme?.accentColor : defaultTheme.accentColor,
}
---

<div class="site-header">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={theme.fontStylesheetUrl} />
  <style define:vars={{
    fontMono: theme.monoFontFamily,
    fontSerif: theme.serifFontFamily,
    bgPrimary: theme.primaryBackgroundColor,
    bgSecondary: theme.secondaryBackgroundColor,
    textColor: theme.primaryTextColor,
    textMuted: theme.mutedTextColor,
    borderColor: theme.borderColor,
    accentColor: theme.accentColor,
  }}>
    :root {
      --font-mono: var(--fontMono);
      --font-serif: var(--fontSerif);
      --bg-primary: var(--bgPrimary);
      --bg-secondary: var(--bgSecondary);
      --bg-tertiary: var(--bgPrimary);
      --hover-bg: var(--bgSecondary);
      --text-color: var(--textColor);
      --text-muted: var(--textMuted);
      --text-dim: var(--textMuted);
      --border-color: var(--borderColor);
      --accent: var(--accentColor);
    }
  </style>

  <header>
    <div class="identity">
      <StoryViewer stories={stories} />
      <a href="/" aria-label="Emmanuel Obiabo, home">
        <strong>Emmanuel Obiabo</strong>
        <small>Software engineer</small>
      </a>
    </div>
    <Nav />
  </header>

  {personalUrls.length > 0 && (
    <div class="social-links" aria-label="Social links">
      {personalUrls.map((item) => (
        <a href={item.url} target="_blank" rel="noreferrer" aria-label={item.headerTitle ?? item.title} title={item.headerTitle ?? item.title}>
          {item.kind === 'github' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A11 11 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.19-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.06.79 2.14v3.28c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
          )}
          {item.kind === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.3 7.7H1.7V22h3.6V7.7ZM3.5 2A2.1 2.1 0 1 0 3.5 6.2 2.1 2.1 0 0 0 3.5 2ZM22.3 13.8c0-4.3-2.3-6.3-5.4-6.3-2.5 0-3.6 1.4-4.2 2.3V7.7H9.1V22h3.6v-7.1c0-1.9.4-3.7 2.7-3.7 2.3 0 2.3 2.1 2.3 3.8v7h3.6l1-8.2Z"/></svg>
          )}
          {item.kind === 'x' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2h3.7l-8 9.2L24 22h-7.4l-5.8-7.6L4.2 22H.5l8.6-9.8L0 2h7.6l5.2 6.9L18.9 2Zm-1.3 18.1h2L6.5 3.8H4.4l13.2 16.3Z"/></svg>
          )}
          {item.kind === 'email' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 4.5h20v15H2v-15Zm2 2v.3l8 5.3 8-5.3v-.3H4Zm16 11v-8.3l-8 5.3-8-5.3v8.3h16Z"/></svg>
          )}
          {item.kind === 'link' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a3 3 0 0 1 4.2 4.2l-2.1 2.1a3 3 0 0 1-4.2 0 1 1 0 0 0-1.4 1.4 5 5 0 0 0 7 0l2.1-2.1a5 5 0 0 0-7-7l-3.5 3.5a1 1 0 0 0 1.4 1.4Zm2.8-2.8a1 1 0 0 1 0 1.4l-3.5 3.5a3 3 0 1 1-4.2-4.2l2.1-2.1a3 3 0 0 1 4.2 0 1 1 0 1 0 1.4-1.4 5 5 0 0 0-7 0l-2.1 2.1a5 5 0 0 0 7 7l3.5-3.5a1 1 0 0 0-1.4-1.4Z"/></svg>
          )}
        </a>
      ))}
    </div>
  )}
</div>

<style>
  .site-header {
    margin: 0 auto;
    max-width: 42rem;
    padding: 4rem 1rem 0;
  }

  header {
    align-items: center;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
  }

  .identity {
    align-items: center;
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.75rem;
  }

  .identity > a {
    display: grid;
  }

  .identity strong {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .identity small {
    color: var(--text-muted);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 1rem 0 0 4rem;
  }

  .social-links a {
    color: var(--text-muted);
    display: inline-flex;
  }

  .social-links svg {
    fill: currentColor;
    height: 0.9rem;
    width: 0.9rem;
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    color: var(--text-color);
  }

  .social-links a:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 0.25rem;
  }

  @media (max-width: 40rem) {
    .site-header {
      padding-top: 2rem;
    }

    .social-links {
      margin-left: 4rem;
    }
  }
</style>
