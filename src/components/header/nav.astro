---
const navItems = [
  { title: 'Home', path: '/' },
  { title: 'Projects', path: '#projects' },
  { title: 'About', path: '/about' },
  { title: 'Notes', path: '/notes' },
  { title: 'Contributions', path: '/open-source-contributions' },
  { title: 'Contact', path: '/reach' },
]
---

<nav aria-label="Primary navigation">
  {navItems.map((item) => {
    const isProjects = item.title === 'Projects'
    const href = isProjects && Astro.url.pathname !== '/' ? `/${item.path}` : item.path
    const isActive = Astro.url.pathname === item.path || (item.path === '/' && Astro.url.pathname === '/')

    return (
      <a href={href} aria-current={isActive ? 'page' : undefined}>
        {item.title}
      </a>
    )
  })}
</nav>

<style>
  nav {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    justify-content: flex-end;
  }

  a {
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.5;
    text-decoration: none;
    text-underline-offset: 0.25rem;
  }

  a:hover,
  a:focus-visible,
  a[aria-current='page'] {
    color: var(--text-color);
    text-decoration: underline;
  }

  a:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 0.25rem;
  }

  @media (max-width: 40rem) {
    nav {
      justify-content: flex-start;
    }
  }
</style>
