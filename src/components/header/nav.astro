---
const navItems = [
  { title: 'Home', path: '/' },
  { title: 'Projects', path: '/projects' },
  { title: 'Gallery', path: '/gallery' },
  { title: 'About', path: '/about' },
  { title: 'Blog', path: '/notes' },
  { title: 'Contributions', path: '/open-source-contributions' },
  { title: 'Work with me', path: '/work-with-me' },
  { title: 'Contact', path: '/reach' },
]

const activePath = Astro.url.pathname
const isActive = (path: string) => activePath === path || (path === '/projects' && activePath.startsWith('/work/')) || (path !== '/' && activePath.startsWith(`${path}/`))
---

<details class="mobile-navigation">
  <summary aria-label="Navigation menu">
    <span></span>
    <span></span>
    <span></span>
  </summary>
  <nav aria-label="Primary navigation">
    {navItems.map((item) => {
      return (
        <a href={item.path} aria-current={isActive(item.path) ? 'page' : undefined}>
          {item.title}
        </a>
      )
    })}
  </nav>
</details>
<nav class="desktop-navigation" aria-label="Primary navigation">
  {navItems.map((item) => (
    <a href={item.path} aria-current={isActive(item.path) ? 'page' : undefined}>
      {item.title}
    </a>
  ))}
</nav>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return
    document.querySelectorAll<HTMLDetailsElement>('.mobile-navigation[open]').forEach((menu) => {
      if (!menu.contains(event.target as Node) || event.target instanceof HTMLAnchorElement) menu.removeAttribute('open')
    })
  })

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return
    document.querySelectorAll<HTMLDetailsElement>('.mobile-navigation[open]').forEach((menu) => {
      menu.removeAttribute('open')
      menu.querySelector('summary')?.focus()
    })
  })
</script>

<style>
  .mobile-navigation {
    position: relative;
  }

  .desktop-navigation {
    display: none;
  }

  summary {
    align-items: center;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    height: 2.25rem;
    justify-content: center;
    list-style: none;
    transition: background-color 180ms ease, border-color 180ms ease;
    width: 2.25rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    background: var(--text-color);
    display: block;
    height: 1px;
    transition: transform 180ms ease, opacity 180ms ease;
    width: 0.85rem;
  }

  summary:hover,
  summary:focus-visible,
  details[open] summary {
    background: var(--bg-secondary);
    border-color: var(--text-muted);
  }

  summary:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 0.2rem;
  }

  details[open] summary span:nth-child(1) {
    transform: translateY(0.28rem) rotate(45deg);
  }

  details[open] summary span:nth-child(2) {
    opacity: 0;
  }

  details[open] summary span:nth-child(3) {
    transform: translateY(-0.28rem) rotate(-45deg);
  }

  .mobile-navigation nav {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    display: grid;
    min-width: 12rem;
    padding: 0.45rem;
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    z-index: 10;
  }

  .mobile-navigation a {
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.5;
    padding: 0.5rem 0.65rem;
    text-decoration: none;
  }

  .mobile-navigation a:hover,
  .mobile-navigation a:focus-visible,
  .mobile-navigation a[aria-current='page'] {
    background: var(--bg-primary) !important;
    color: var(--text-color);
  }

  .mobile-navigation a:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }

  @media (min-width: 75rem) {
    .mobile-navigation {
      display: none;
    }

    .desktop-navigation {
      display: flex;
      flex-direction: column;
      inset-block: 7rem 1.5rem;
      inset-inline-start: clamp(1rem, 4vw, 3rem);
      overflow-y: auto;
      position: fixed;
      width: 12rem;
      z-index: 10;
    }

    .desktop-navigation a {
      align-items: center;
      color: var(--text-muted);
      display: flex;
      font-size: 0.72rem;
      font-weight: 400;
      line-height: 1.5;
      min-height: 2.25rem;
      padding-inline: 0.5rem;
      text-decoration: none;
      transition: color 140ms ease;
    }

    .desktop-navigation a:last-child {
      margin-top: auto;
    }

    .desktop-navigation a:hover,
    .desktop-navigation a:focus-visible,
    .desktop-navigation a[aria-current='page'] {
      color: var(--text-color);
    }

    .desktop-navigation a[aria-current='page'] {
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 0.35rem;
    }

    .desktop-navigation a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 0.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    summary,
    summary span,
    .desktop-navigation a {
      transition: none;
    }
  }
</style>
