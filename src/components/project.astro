---
type Project = {
  name: string
  description: string
  details?: string
  url: string
}

type Props = {
  projects: Project[]
  title?: string
  intro?: string
  moreHref?: string
  headingLevel?: 'h1' | 'h2'
}

const {
  projects,
  title = 'Projects',
  intro,
  moreHref,
  headingLevel = 'h2',
} = Astro.props
---

<section class="projects" id="projects" aria-labelledby="projects-title">
  {headingLevel === 'h1' ? <h1 id="projects-title">{title}</h1> : <h2 id="projects-title">{title}</h2>}
  {intro && <p class="projects-intro">{intro}</p>}

  {projects.length > 0 ? (
    <ul>
      {projects.map((project, index) => (
        <li>
          <button type="button" class="project-trigger" data-project-dialog={`project-${index}`} aria-haspopup="dialog">
            <span class="project-name">{project.name}</span>
            <span class="project-description">{project.description}</span>
          </button>
          <dialog id={`project-${index}`} class="project-dialog" aria-labelledby={`project-title-${index}`}>
            <div class="dialog-heading">
              <span class="dialog-kicker">Selected project / {String(index + 1).padStart(2, '0')}</span>
              <form method="dialog">
                <button type="submit" class="dialog-close" aria-label={`Close ${project.name} details`}>×</button>
              </form>
            </div>
            <h3 id={`project-title-${index}`}>{project.name}</h3>
            <div class="dialog-copy">
              <p>{project.description}</p>
              {project.details?.trim() && project.details.trim().split(/\n\s*\n/).map((paragraph) => <p>{paragraph.trim()}</p>)}
            </div>
            <a class="project-visit" href={project.url} target="_blank" rel="noopener noreferrer">
              Visit project <span aria-hidden="true">↗</span>
            </a>
          </dialog>
        </li>
      ))}
    </ul>
  ) : (
    <p class="projects-empty">No featured projects yet.</p>
  )}
  {moreHref && <a class="more-projects" href={moreHref}>Show more projects <span aria-hidden="true">→</span></a>}
</section>

<style>
  .projects {
    margin-bottom: 4rem;
    scroll-margin-top: 2rem;
  }

  h1,
  h2 {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.5;
    margin: 0 0 1.15rem;
  }

  .projects-intro,
  .projects-empty {
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.6;
    margin: -0.7rem 0 1.5rem;
  }

  .more-projects {
    color: var(--text-color);
    display: inline-block;
    font-size: 0.76rem;
    margin-top: 0.2rem;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .more-projects:hover,
  .more-projects:focus-visible {
    color: var(--accent);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    margin-bottom: 1.45rem;
  }

  .project-trigger {
    appearance: none;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
    display: block;
    padding: 0;
    text-align: left;
    width: 100%;
  }

  .project-trigger:hover .project-name,
  .project-trigger:focus-visible .project-name {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .project-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 0.3rem;
  }

  .project-name {
    display: block;
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.5;
    text-decoration: underline;
    text-decoration-color: var(--text-muted);
    text-underline-offset: 0.2rem;
  }

  .project-description {
    display: block;
    font-size: 0.76rem;
    line-height: 1.6;
    margin-top: 0.15rem;
    color: var(--text-muted);
  }

  .project-dialog {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-color);
    margin: auto;
    max-height: min(80dvh, 42rem);
    max-width: min(34rem, calc(100vw - 2rem));
    padding: 1.5rem;
    width: 100%;
  }

  .project-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
    backdrop-filter: blur(4px);
  }

  .dialog-heading {
    align-items: start;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .dialog-kicker {
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  .dialog-close {
    background: transparent;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
    font-size: 1.35rem;
    line-height: 1;
    padding: 0;
  }

  .dialog-close:hover,
  .dialog-close:focus-visible {
    color: var(--text-color);
  }

  .project-dialog h3 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    margin: 1.5rem 0 1rem;
  }

  .dialog-copy p {
    font-size: 0.82rem;
    line-height: 1.7;
    margin: 0 0 1rem;
  }

  .project-visit {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .project-visit:hover,
  .project-visit:focus-visible {
    color: var(--accent);
  }

  @media (max-width: 40rem) {
    .project-dialog {
      padding: 1.25rem;
    }
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return

    const trigger = event.target.closest<HTMLButtonElement>('[data-project-dialog]')
    if (trigger) {
      const dialog = document.getElementById(trigger.dataset.projectDialog ?? '')
      if (dialog instanceof HTMLDialogElement) dialog.showModal()
      return
    }

    if (event.target instanceof HTMLDialogElement && event.target.classList.contains('project-dialog')) {
      event.target.close()
    }
  })
</script>
