---
type Project = {
  name: string
  description: string
  url: string
}

type Props = {
  projects: Project[]
  title?: string
  description?: string
}

const {
  projects,
  title = 'Selected work',
  description = "I've worked on many private services and applications. These are some of the public ones.",
} = Astro.props
---

{projects.length > 0 && (
  <section class="projects" id="projects" aria-labelledby="projects-title">
    <div class="section-heading">
      <h2 id="projects-title">{title}</h2>
      <p>{description}</p>
    </div>

    <ul>
      {projects.map((project) => (
        <li>
          <a href={project.url} target="_blank" rel="noreferrer">
            <span class="project-name">{project.name}</span>
            <span class="project-description">{project.description}</span>
            <span class="project-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .projects {
    margin-bottom: 4.5rem;
    scroll-margin-top: 2rem;
  }

  .section-heading {
    margin-bottom: 1.25rem;
  }

  h2 {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 0.35rem;
    text-transform: lowercase;
  }

  .section-heading p {
    color: var(--text-muted);
    font-size: 0.7rem;
    line-height: 1.6;
    margin: 0;
    max-width: 34rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    border-top: 1px solid var(--border-color);
  }

  li:last-child {
    border-bottom: 1px solid var(--border-color);
  }

  li a {
    align-items: baseline;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(7rem, 0.7fr) minmax(0, 1.8fr) auto;
    padding: 0.85rem 0;
  }

  li a:hover .project-name,
  li a:focus-visible .project-name,
  li a:hover .project-arrow,
  li a:focus-visible .project-arrow {
    color: var(--accent);
  }

  li a:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 0.25rem;
  }

  .project-name {
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .project-description {
    color: var(--text-muted);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .project-arrow {
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  @media (max-width: 36rem) {
    li a {
      gap: 0.2rem 0.75rem;
      grid-template-columns: 1fr auto;
    }

    .project-description {
      grid-column: 1;
    }

    .project-arrow {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
