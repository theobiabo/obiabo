---
import introMarkdown from '../../data/intro.md?raw'
import { renderMarkdown } from '../../utils/markdownRenderer'

const introHtml = renderMarkdown(introMarkdown)
---

<section class="about-intro" aria-label="Introduction">
  <article class="intro-prose">
    <Fragment set:html={introHtml} />
  </article>
</section>

<style>
  .about-intro {
    margin-bottom: 4rem;
  }

  :global(.intro-prose p) {
    font-size: 0.82rem;
    line-height: 1.65;
    margin: 0;
  }

  :global(.intro-prose p + p) {
    margin-top: 1.5rem;
  }

  :global(.intro-prose a) {
    text-decoration: underline;
    text-decoration-color: var(--text-muted);
    text-underline-offset: 0.2rem;
  }

  :global(.intro-prose a:hover),
  :global(.intro-prose a:focus-visible) {
    text-decoration-color: currentColor;
  }

  :global(.intro-prose a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
