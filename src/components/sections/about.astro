---
const { more } = Astro.props

import { getSanityAbout } from '../../utils/getSanityAbout'
import { renderMarkdown } from '../../utils/markdownRenderer'

const about = await getSanityAbout()
const introHtml = renderMarkdown(about?.introMarkdown ?? '')
---

<section class="about-intro" aria-label="Introduction">
  <article class="markdown-content">
    <Fragment set:html={introHtml} />
  </article>

  {more && <a class="more-link" href="/about">More about me <span aria-hidden="true">→</span></a>}
</section>

<style>
  .about-intro {
    margin-bottom: 4.5rem;
  }

  .markdown-content {
    font-size: 0.82rem;
    line-height: 1.75;
  }

  .more-link {
    color: var(--text-muted);
    display: inline-block;
    font-size: 0.72rem;
    margin-top: 1.25rem;
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }

  .more-link:hover,
  .more-link:focus-visible {
    color: var(--text-color);
  }
</style>
