---
type Props = {
  title?: string
  description?: string
  type?: 'website' | 'article' | 'profile'
  image?: string
  imageAlt?: string
  imageWidth?: number
  imageHeight?: number
  appendSiteName?: boolean
  canonicalUrl?: string
  noindex?: boolean
}

const {
  title = 'Emmanuel Obiabo | Software engineer',
  description = 'The world is a beautiful place, I\'m making it better through code.',
  type = 'website',
  image = '/assets/og-card.png',
  imageAlt = 'Emmanuel Obiabo, software engineer',
  imageWidth,
  imageHeight,
  appendSiteName = true,
  canonicalUrl,
  noindex = false,
} = Astro.props

const siteName = 'Emmanuel Obiabo'
const defaultImage = '/assets/og-card.png'
const configuredSiteUrl = import.meta.env.SITE_URL?.trim()
const baseUrl = Astro.site ?? new URL(configuredSiteUrl || Astro.url.origin)
const siteTitle = appendSiteName && title !== siteName && !title.includes(siteName)
  ? `${title} | ${siteName}`
  : title
const canonical = canonicalUrl
  ? new URL(canonicalUrl, baseUrl)
  : new URL(Astro.url.pathname, baseUrl)
const resolvedImage = image?.trim() || defaultImage
const ogImage = new URL(resolvedImage, baseUrl)
const isDefaultImage = resolvedImage === defaultImage
const resolvedImageWidth = imageWidth ?? (isDefaultImage ? 1200 : undefined)
const resolvedImageHeight = imageHeight ?? (isDefaultImage ? 630 : undefined)
const imageExtension = ogImage.pathname.split('.').pop()?.toLowerCase()
const imageType = imageExtension === 'png'
  ? 'image/png'
  : imageExtension === 'webp'
    ? 'image/webp'
    : imageExtension === 'jpg' || imageExtension === 'jpeg'
      ? 'image/jpeg'
      : undefined
---

<title>{siteTitle}</title>
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/icons/icon-192.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#141414" />
<script is:inline>
  try {
    document.documentElement.dataset.theme = localStorage.getItem('obiabo-theme') === 'light' ? 'light' : 'dark'
  } catch {
    document.documentElement.dataset.theme = 'dark'
  }
  if (!window.__obiaboThemeBound) {
  window.__obiaboThemeBound = true
  document.addEventListener('astro:before-swap', (event) => {
    event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme || 'dark'
  })
  document.addEventListener('click', (event) => {
    const button = event.target.closest?.('[data-theme-toggle]')
    if (!button) return
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light'
    document.documentElement.dataset.theme = next
    try { localStorage.setItem('obiabo-theme', next) } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#fbfaf7' : '#141414')
    document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
      toggle.setAttribute('aria-label', `Switch to ${next === 'light' ? 'dark' : 'light'} mode`)
      toggle.setAttribute('title', `Switch to ${next === 'light' ? 'dark' : 'light'} mode`)
    })
  })
  document.addEventListener('astro:page-load', () => {
    const isLight = document.documentElement.dataset.theme === 'light'
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isLight ? '#fbfaf7' : '#141414')
    document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => {
      toggle.setAttribute('aria-label', `Switch to ${isLight ? 'dark' : 'light'} mode`)
      toggle.setAttribute('title', `Switch to ${isLight ? 'dark' : 'light'} mode`)
    })
  })
  }
</script>
<meta name="description" content={description} />
<meta name="author" content="Emmanuel Obiabo" />
<meta name="creator" content="Emmanuel Obiabo" />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
<link rel="canonical" href={canonical.toString()} />

<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical.toString()} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage.toString()} />
<meta property="og:image:secure_url" content={ogImage.toString()} />
{imageType && <meta property="og:image:type" content={imageType} />}
{resolvedImageWidth && <meta property="og:image:width" content={String(resolvedImageWidth)} />}
{resolvedImageHeight && <meta property="og:image:height" content={String(resolvedImageHeight)} />}
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@obiabo_immanuel" />
<meta name="twitter:creator" content="@obiabo_immanuel" />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.toString()} />
<meta name="twitter:image:alt" content={imageAlt} />

<script>
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      void navigator.serviceWorker.register('/sw.js', {scope: '/'}).catch(() => {})
    }, {once: true})
  }
</script>
