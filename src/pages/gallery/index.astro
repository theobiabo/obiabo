---
import Header from '../../components/header/index.astro'
import SEO from '../../components/seo/index.astro'
import { getSanityGallery } from '../../utils/getSanityGallery'
import '../../style/index.css'
import { ClientRouter } from 'astro:transitions'

const galleryItems = await getSanityGallery()
const categoryLabels = { personal: 'Personal', coffee: 'Coffee', other: 'Other' }
const requestedCategory = Astro.url.searchParams.get('category')
const selectedCategory = requestedCategory === 'personal' || requestedCategory === 'coffee' || requestedCategory === 'other'
  ? requestedCategory
  : 'all'
const categoryFilters = Object.entries(categoryLabels)
  .map(([value, label]) => ({ value, label, count: galleryItems.filter((item) => item.category === value).length }))
  .filter(({ count }) => count > 0)
const visibleItems = selectedCategory === 'all'
  ? galleryItems
  : galleryItems.filter((item) => item.category === selectedCategory)
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title="Gallery" description="A visual gallery of moments and places photographed by Emmanuel Obiabo." />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main class="gallery-shell">
      <header class="gallery-heading">
        <h1>Gallery</h1>
        <p>A collection of moments, places, and things worth keeping.</p>
      </header>

      {galleryItems.length > 0 ? (
        <>
          <nav class="gallery-filters" aria-label="Filter photos by category">
            <a href="/gallery" aria-current={selectedCategory === 'all' ? 'page' : undefined}>All <span>{galleryItems.length}</span></a>
            {categoryFilters.map(({ value, label, count }) => (
              <a href={`/gallery?category=${value}`} aria-current={selectedCategory === value ? 'page' : undefined}>{label} <span>{count}</span></a>
            ))}
          </nav>
          {visibleItems.length > 0 ? (
            <section class="gallery-grid" aria-label="Photo gallery">
              {visibleItems.map((item) => (
                <figure>
                  <img
                    src={item.imageUrl}
                    alt={item.alt}
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                    decoding="async"
                  />
                  {(item.title || item.note) && (
                    <figcaption>
                      <span class="gallery-category">{categoryLabels[item.category]}</span>
                      <strong>{item.title}</strong>
                      {item.note && <span>{item.note}</span>}
                    </figcaption>
                  )}
                </figure>
              ))}
            </section>
          ) : (
            <p class="empty-gallery">No photos in this category yet.</p>
          )}
        </>
      ) : (
        <p class="empty-gallery">The gallery is being curated.</p>
      )}
    </main>
  </body>
</html>

<style>
  .gallery-shell {
    margin: 0 auto;
    max-width: 42rem;
    padding: 3rem 1rem 5rem;
  }

  .gallery-heading {
    margin: 0 0 2.5rem;
  }

  h1 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 0.4rem;
  }

  .gallery-heading p,
  .empty-gallery {
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.7;
    margin: 0;
  }

  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0 0 1.75rem;
  }

  .gallery-filters a {
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    display: inline-flex;
    gap: 0.3rem;
    font-size: 0.68rem;
    padding: 0.3rem 0.65rem;
  }

  .gallery-filters a:hover,
  .gallery-filters a[aria-current='page'] {
    border-color: var(--accent);
    color: var(--text-color);
  }

  .gallery-filters a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .gallery-filters span {
    color: var(--text-muted);
    font-size: 0.62rem;
  }

  .empty-gallery {
    margin: 5rem auto;
    max-width: 42rem;
  }

  .gallery-grid {
    column-count: 2;
    column-gap: 1.25rem;
  }

  figure {
    break-inside: avoid;
    display: inline-block;
    margin: 0 0 1.75rem;
    width: 100%;
  }

  img {
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
    padding-top: 0.6rem;
  }

  figcaption strong {
    font-size: 0.68rem;
    font-weight: 500;
    line-height: 1.5;
  }

  figcaption span {
    color: var(--text-muted);
    font-size: 0.64rem;
    line-height: 1.55;
  }

  figcaption .gallery-category {
    color: var(--accent);
    font-size: 0.6rem;
    text-transform: uppercase;
  }

  @media (max-width: 34rem) {
    .gallery-grid {
      column-count: 1;
    }
  }
</style>
