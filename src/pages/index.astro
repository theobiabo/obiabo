---
import Header from '../components/header/index.astro'
import Project from '../components/project.astro'
import About from '../components/sections/about.astro'
import RecentPosts from '../components/RecentPosts.astro'
import ActivityFeed from '../components/ActivityFeed.astro'
import SEO from '../components/seo/index.astro'
import { getSanityProjects } from '../utils/getSanityProjects'
import { ClientRouter } from 'astro:transitions'
import '../../src/style/index.css'

const featuredProjects = await getSanityProjects({ featuredOnly: true, limit: 5 })
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEO />
    <ClientRouter />

    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-GSQTWFBD18"></script>
    <script>
      import { initializeAnalytics } from '../utils/analytics';
      initializeAnalytics();
    </script>


  </head>
  <body class="editorial-page home-page">
    <Header />
    <main class="page-shell">
      <About />
      <RecentPosts />
      <Project projects={featuredProjects} moreHref="/projects" />
      <ActivityFeed />
    </main>
  </body>
</html>
