---
import Header from '../components/header/index.astro'
import Project from '../components/project.astro'
import About from '../components/sections/about.astro'
import RecentPosts from '../components/RecentPosts.astro'
import ActivityFeed from '../components/ActivityFeed.astro'
import SEO from '../components/seo/index.astro'
import { getSanityProjects } from '../utils/getSanityProjects'
import { ClientRouter } from 'astro:transitions'
import '../../src/style/index.css'

const featuredWork = [
  {
    name: 'cNGN Rust SDK',
    description: 'A typed Rust client for the cNGN stablecoin API.',
    details: 'I developed this open-source SDK for cNGN, a stablecoin pegged 1:1 to the Nigerian naira. It uses AES-256-CBC request encryption and Ed25519 response decryption. The client covers wallet management, virtual account deposits, bank redemptions, and on-chain transfers.',
    url: 'https://github.com/theobiabo/cNGN-rs',
  },
  {
    name: 'Plunk Rust SDK',
    description: 'Previously, I worked on this community Rust SDK for Plunk\'s email platform.',
    details: 'A community Rust SDK for Plunk, published on crates.io.',
    url: 'https://crates.io/crates/plunk',
  },
]

const sanityProjects = await getSanityProjects()
const featuredUrls = new Set(featuredWork.map((project) => project.url.replace(/\/$/, '').toLowerCase()))
const projects = [
  ...featuredWork,
  ...sanityProjects.filter((project) => !featuredUrls.has(project.url.replace(/\/$/, '').toLowerCase())),
]
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <SEO />
    <ClientRouter />

    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-GSQTWFBD18"></script>
    <script>
      import { initializeAnalytics } from '../utils/analytics';
      initializeAnalytics();
    </script>


  </head>
  <body class="editorial-page home-page">
    <Header />
    <main class="page-shell">
      <About />
      <RecentPosts />
      <Project projects={projects} />
      <ActivityFeed />
    </main>
  </body>
</html>
