---
export const prerender = false

import {db, views} from 'astro:db'
import {ClientRouter} from 'astro:transitions'
import Header from '../../components/header/index.astro'
import SEO from '../../components/seo/index.astro'
import {getSanityPosts} from '../../utils/getSanityPosts'
import '../../style/index.css'

type Post = {
  _id?: string
  _createdAt?: string | null
  slug?: {current?: string}
  title: string
  description?: string
  firstPublishedAt?: string | null
  publishedAt?: string | null
}

const posts = ((await getSanityPosts()) as Post[]).filter((post) => post.slug?.current)

const getPostDateValue = (post: Post) => {
  const date = post.firstPublishedAt || post.publishedAt || post._createdAt
  const time = date ? new Date(date).getTime() : 0
  return Number.isNaN(time) ? 0 : time
}

const dateFormatter = new Intl.DateTimeFormat('en-US', {dateStyle: 'long'})

const formatPostDate = (post: Post) => {
  const date = post.firstPublishedAt || post.publishedAt || post._createdAt
  const parsedDate = date ? new Date(date) : null
  return parsedDate && !Number.isNaN(parsedDate.getTime()) ? dateFormatter.format(parsedDate) : 'Date unavailable'
}

const sort = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'latest'
const pageSize = 5
const requestedPage = Number(Astro.url.searchParams.get('page') || '1')
const sortedPosts = [...posts].sort((a, b) => (
  sort === 'oldest'
    ? getPostDateValue(a) - getPostDateValue(b)
    : getPostDateValue(b) - getPostDateValue(a)
))
const totalPages = Math.max(1, Math.ceil(sortedPosts.length / pageSize))
const currentPage = Math.min(Math.max(Number.isNaN(requestedPage) ? 1 : requestedPage, 1), totalPages)
const paginatedPosts = sortedPosts.slice((currentPage - 1) * pageSize, currentPage * pageSize)
const pageNumbers = Array.from({length: totalPages}, (_, index) => index + 1)

const getPageHref = (page: number) => {
  const params = new URLSearchParams()
  if (sort !== 'latest') params.set('sort', sort)
  if (page > 1) params.set('page', String(page))
  const query = params.toString()
  return query ? `/notes?${query}` : '/notes'
}

const allViews = await db.select().from(views)
const viewCounts: Record<string, number> = {}

allViews.forEach((view) => {
  viewCounts[view.postId] = (viewCounts[view.postId] || 0) + 1
})
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title="Blog" description="Writing about software, systems, and ideas I am exploring." />
    <ClientRouter />
  </head>
  <body>
    <Header title="Blog" />

    <main class="page-shell">
      <header class="mb-10 sm:mb-12">
        <h1 class="m-0 text-lg  leading-tight tracking-[-0.02em] sm:text-md">
          Blog
        </h1>
        <p class="mt-2 max-w-xl text-xs leading-6 text-[var(--text-muted)] sm:text-sm">
          Writing about software, systems, and ideas I am exploring.
        </p>
      </header>

      <section aria-labelledby="posts-heading">
        <h2 id="posts-heading" class="sr-only">Posts</h2>

        <form method="get" class="mb-8 grid grid-cols-[1fr_auto] items-end gap-3 sm:flex sm:items-center">
          <label for="sort" class="col-span-2 text-xs text-[var(--text-muted)] sm:col-auto">
            Sort posts
          </label>
          <select
            id="sort"
            name="sort"
            class="min-h-11 rounded-md border border-[var(--border-color)] bg-[var(--bg-primary)] px-3 text-xs text-[var(--text-color)] outline-none focus:border-[var(--accent)] sm:min-h-9"
          >
            <option value="latest" selected={sort === 'latest'}>Latest first</option>
            <option value="oldest" selected={sort === 'oldest'}>Oldest first</option>
          </select>
          <button
            type="submit"
            class="min-h-11 rounded-md border border-[var(--border-color)] px-4 text-xs font-medium transition-colors duration-150 hover:border-[var(--text-muted)] hover:text-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)] sm:min-h-9"
          >
            Apply
          </button>
        </form>

        {paginatedPosts.length > 0 ? (
          <div class="border-y border-[var(--border-color)]">
            {paginatedPosts.map((post) => {
              const postId = post.slug?.current || ''
              const viewsCount = viewCounts[postId] || 0

              return (
                <article class="border-b border-[var(--border-color)] py-6 last:border-b-0 sm:py-7">
                  <h3 class="m-0 text-sm font-normal leading-6 sm:text-base">
                    <a
                      href={`/notes/${postId}`}
                      class="underline decoration-transparent
                      underline-offset-4 transition-colors duration-150
                      hover:text-[var(--accent)] hover:decoration-current
                      focus-visible:rounded-sm focus-visible:outline
                      focus-visible:outline-2 focus-visible:outline-offset-4
                      focus-visible:outline-[var(--accent)]"
                    >
                      {post.title}
                    </a>
                  </h3>

                  {post.description && (
                    <p class="mt-2 max-w-2xl text-xs leading-6 text-[var(--text-muted)] sm:text-sm sm:leading-7">
                      {post.description}
                    </p>
                  )}

                  <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-[0.68rem] text-[var(--text-muted)] sm:text-xs">
                    <time datetime={post.firstPublishedAt || post.publishedAt || post._createdAt || undefined}>
                      {formatPostDate(post)}
                    </time>
                    <span class="inline-flex items-center gap-1.5" aria-label={`${viewsCount} ${viewsCount === 1 ? 'view' : 'views'}`}>
                      <svg aria-hidden="true" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                      <span aria-hidden="true">{viewsCount}</span>
                    </span>
                  </div>
                </article>
              )
            })}
          </div>
        ) : (
          <div class="border-y border-[var(--border-color)] py-12 text-center">
            <h3 class="text-sm font-medium">No posts yet</h3>
            <p class="mt-2 text-xs leading-6 text-[var(--text-muted)]">
              New writing will appear here when it is published.
            </p>
          </div>
        )}

        {totalPages > 1 && (
          <nav class="mt-8 flex flex-col gap-4 text-xs sm:flex-row sm:items-center sm:justify-between" aria-label="Blog pagination">
            <p class="text-[var(--text-muted)]">Page {currentPage} of {totalPages}</p>

            <div class="flex flex-wrap items-center gap-1.5">
              {currentPage > 1 ? (
                <a href={getPageHref(currentPage - 1)} class="inline-flex min-h-10 items-center rounded-md px-3 hover:text-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]">
                  ← Previous
                </a>
              ) : (
                <span class="inline-flex min-h-10 items-center px-3 text-[var(--text-muted)] opacity-50">← Previous</span>
              )}

              {pageNumbers.map((page) => (
                page === currentPage ? (
                  <span class="inline-flex h-9 min-w-9 items-center justify-center rounded-md bg-[var(--accent)] px-2 text-white" aria-current="page">
                    {page}
                  </span>
                ) : (
                  <a href={getPageHref(page)} class="inline-flex h-9 min-w-9 items-center justify-center rounded-md px-2 hover:bg-[var(--hover-bg)] hover:text-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]">
                    {page}
                  </a>
                )
              ))}

              {currentPage < totalPages ? (
                <a href={getPageHref(currentPage + 1)} class="inline-flex min-h-10 items-center rounded-md px-3 hover:text-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]">
                  Next →
                </a>
              ) : (
                <span class="inline-flex min-h-10 items-center px-3 text-[var(--text-muted)] opacity-50">Next →</span>
              )}
            </div>
          </nav>
        )}
      </section>

      <footer class="mt-14 border-t border-[var(--border-color)] pt-6 text-xs leading-6 text-[var(--text-muted)] sm:mt-16">
        <p>Notes on software, systems, and ongoing research.</p>
      </footer>
    </main>
  </body>
</html>
