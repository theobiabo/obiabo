---
import Header from '../../components/header/index.astro'
import SEO from '../../components/seo/index.astro'
import { getSanityWorkWithMePage } from '../../utils/getSanityWorkWithMePage'
import { ClientRouter } from 'astro:transitions'
import '../../style/index.css'

const page = await getSanityWorkWithMePage()
const contactPath = page?.contactPath && /^\/(?!\/)/.test(page.contactPath) ? page.contactPath : '/reach'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title="Work with me" description={page?.seoDescription ?? 'Work with Emmanuel Obiabo.'} />
    <ClientRouter />
  </head>
  <body class="editorial-page">
    <Header />
    <main class="page-shell text-[0.82rem] font-normal leading-[1.65]">
      {page ? (
        <Fragment>
          <h1 class="mb-6 text-base font-normal leading-6">{page.heading}</h1>
          <p class="mb-5 font-normal">{page.intro}</p>

          <h2 class="mb-3 mt-8 text-[0.82rem] font-normal leading-6">{page.topicsHeading}</h2>
          <ol class="mb-8 list-decimal space-y-2 pl-6 font-normal">
            {page.topics?.map((topic) => <li class="font-normal">{topic}</li>)}
          </ol>

          {page.selectedWork && page.selectedWork.length > 0 && (
            <section class="mb-8" aria-label={page.selectedWorkHeading ?? 'Selected work'}>
              <h2 class="mb-3 mt-8 text-[0.82rem] font-normal leading-6">
                {page.selectedWorkHeading ?? 'Selected work'}
              </h2>
              <ul class="m-0 list-none p-0">
                {page.selectedWork.map((item) => (
                  <li class="border-t border-[var(--border-color)] font-normal">
                    {item.slug?.current ? (
                      <a
                        href={`/work/${item.slug.current}`}
                        class="group grid gap-1 py-3 font-normal no-underline outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)]"
                      >
                        <span class="font-normal text-[var(--text-color)] group-hover:text-[var(--accent)]">
                          {item.organization}
                        </span>
                        <span class="font-normal text-[var(--text-muted)]">{item.summary}</span>
                      </a>
                    ) : (
                      <div class="grid gap-1 py-3 font-normal">
                        <span class="font-normal text-[var(--text-color)]">{item.organization}</span>
                        <span class="font-normal text-[var(--text-muted)]">{item.summary}</span>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )}

          <p class="border-t border-[var(--border-color)] pt-5 font-normal">
            {page.contactPrompt}{' '}
            <a
              href={contactPath}
              class="font-normal underline underline-offset-[0.2rem] outline-none hover:text-[var(--accent)] focus-visible:ring-2 focus-visible:ring-[var(--accent)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-primary)]"
            >
              {page.contactLinkLabel}
            </a>.
          </p>
        </Fragment>
      ) : (
        <p class="font-normal">Work with me content is unavailable.</p>
      )}
    </main>
  </body>
</html>
