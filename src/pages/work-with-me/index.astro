---
import Header from '../../components/header/index.astro'
import SEO from '../../components/seo/index.astro'
import { getSanityWorkWithMePage } from '../../utils/getSanityWorkWithMePage'
import { ClientRouter } from 'astro:transitions'
import '../../style/index.css'

const page = await getSanityWorkWithMePage()
const contactPath = page?.contactPath && /^\/(?!\/)/.test(page.contactPath) ? page.contactPath : '/reach'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title="Work with me" description={page?.seoDescription ?? 'Work with Emmanuel Obiabo.'} />
    <ClientRouter />
  </head>
  <body class="editorial-page">
    <Header />
    <main class="page-shell work-content">
      {page ? (
        <>
          <h1>{page.heading}</h1>
          <p>{page.intro}</p>
          <h2>{page.topicsHeading}</h2>
          <ol>
            {page.topics?.map((topic) => <li>{topic}</li>)}
          </ol>
          <p class="work-contact">
            {page.contactPrompt} <a href={contactPath}>{page.contactLinkLabel}</a>.
          </p>
        </>
      ) : (
        <p>Work with me content is unavailable.</p>
      )}
    </main>
  </body>
</html>

<style>
  .work-content {
    font-size: 0.82rem;
    line-height: 1.65;
  }

  h1 {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }

  h2 {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
    margin: 2rem 0 0.75rem;
  }

  p {
    margin: 0 0 1.25rem;
  }

  ol {
    list-style: decimal;
    margin: 0 0 2rem;
    padding-left: 1.5rem;
  }

  li + li {
    margin-top: 0.55rem;
  }

  a {
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  a:hover {
    color: var(--accent);
  }

  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .work-contact {
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }
</style>
